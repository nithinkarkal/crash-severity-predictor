# infra/airflow/.env.example
# Copy to `.env` (in this infra/airflow/ folder) and edit HOST_PROJECT_ROOT.
# `docker compose` auto-reads .env; it is git-ignored so your local paths stay local.

# Absolute HOST path to the repo root. Used by the DAG to bind-mount the real
# data/ and artifacts/ folders into each pipeline task container.
#   Windows (use forward slashes): C:/Users/you/Documents/GitHub/accident-severity-predictor
#   macOS / Linux:                 /home/you/accident-severity-predictor
HOST_PROJECT_ROOT=C:/Users/you/Documents/GitHub/accident-severity-predictor

# Image tags the DAGs launch. Defaults are fine if you built them with the
# main project's compose (Phase 5): docker compose ... build
ASP_BACKEND_IMAGE=asp-backend:latest
ASP_TRAINING_IMAGE=asp-training:latest
# Helper image for the DVC-version + data-validation tasks (retraining DAG).
# Build it with: docker build -f infra/airflow/Dockerfile.runner -t asp-airflow-runner:latest infra/airflow
ASP_RUNNER_IMAGE=asp-airflow-runner:latest
# Drift image for the retraining DAG's detect_drift task (isolated Evidently).
# Build it with: docker build -f infra/airflow/Dockerfile.drift -t asp-drift:latest infra/airflow
ASP_DRIFT_IMAGE=asp-drift:latest
# F1 floor for the drift/quality gate — promotion is blocked if F1 on the new batch is below this.
ASP_F1_THRESHOLD=0.65

# --- Retraining DAG only ---------------------------------------------------
# DagsHub S3 credentials for the `version_dataset_dvc` task (dvc push).
# Get a token at dagshub.com -> your repo -> Remote -> Data. Leave blank to skip DVC.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# URL the `reload_fastapi` (STEP 7) task POSTs to, so the running backend serves the
# newly promoted model without a restart. The backend exposes POST /api/v1/model/reload.
# On Docker Desktop the Airflow container reaches the host-mapped backend via
# host.docker.internal. Requires the backend to be running (mapped to host :8000).
# Leave blank to skip the reload (the model still goes live on the backend's next start).
FASTAPI_RELOAD_URL=http://host.docker.internal:8000/api/v1/model/reload

# Slack incoming-webhook URL for STEP 8 alerts (success/failure). Create one at
# https://api.slack.com/messaging/webhooks. Leave blank to log alerts only (no Slack).
SLACK_WEBHOOK_URL=

# Linux ONLY: GID of the docker socket group, so Airflow can use the socket.
#   Find it with: getent group docker | cut -d: -f3
# Ignored on Docker Desktop (Windows/macOS) — leave the default.
DOCKER_GID=999
