# ASP frontend (Streamlit GUI)
FROM python:3.12-slim

WORKDIR /app

# uv for fast, locked installs
RUN pip install --no-cache-dir uv

# install only the frontend dependency group (from the locked file)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group frontend

# app code (absolute imports like `services.frontend...` need the repo root on PYTHONPATH)
COPY common ./common
COPY services ./services
# Streamlit theme config (forces dark mode by default)
COPY .streamlit ./.streamlit
ENV PYTHONPATH=/app

EXPOSE 8501

# Streamlit served on 0.0.0.0:8501; headless (no browser auto-open) for containers.
CMD ["uv", "run", "--no-sync", "streamlit", "run", "services/frontend/src/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
